digraph G { graph [bgcolor="transparent", rankdir=LR, nodesep=.45, ranksep=.55, pad=.2]; node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10, color="#9D7A2E", fillcolor="#FFF9EC"]; edge [color="#777777", fontname="Noto Sans CJK SC", fontsize=8]; U[label="Unknown"]; S[label="Stopped"]; A[label="Starting"]; R[label="Running",fillcolor="#E9F5E5"]; T[label="Stopping"]; D[label="Destroyed"]; E[label="Error",fillcolor="#FCE8E6"]; U->S [label="discover"]; U->R [label="discover"]; S->A [label="start"]; A->R [label="ok"]; A->E [label="fail"]; R->T [label="stop"]; T->S [label="ok"]; T->E [label="fail"]; S->D [label="destroy"]; R->E [label="provider error"]; E->S [label="reconcile"]; E->R [label="reconcile"]; }