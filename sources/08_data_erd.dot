digraph G { graph [bgcolor="transparent",rankdir=LR,pad=.2]; node [shape=record,fontname="Noto Sans CJK SC",fontsize=8,color="#9D7A2E",fillcolor="#FFF9EC",style="filled"]; edge[color="#777777"]; resource[label="RESOURCE|id PK|provider_id|kind|name|state|parent_id|last_seen"]; relation[label="RESOURCE_RELATION|from_id|to_id|kind"]; plugin[label="PLUGIN_PACKAGE|plugin_id+version PK|hash|manifest|license"]; inst[label="PLUGIN_INSTANCE|instance_id PK|plugin_id|generation|state|health"]; docker[label="DOCKER_ENDPOINT|id PK|uri|api_version|health"]; snap[label="SNAPSHOT|id PK|resource_id|created_at|manifest_hash"]; entry[label="SNAPSHOT_ENTRY|snapshot_id+uri PK|content_hash|size"]; event[label="EVENT_LOG|id PK|resource_id|type|correlation_id|created_at"]; resource->relation; relation->resource; plugin->inst; resource->docker [style=dashed]; resource->snap; snap->entry; resource->event; }