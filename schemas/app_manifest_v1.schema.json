{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandTree App Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "app_id",
    "version",
    "clusters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "app_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "plugins"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "plugins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}